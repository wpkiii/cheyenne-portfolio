# Shopify Buy Button — copy to .env.local for local dev, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# Values come from Shopify admin → Sales channels → Buy Button → embed code.
NEXT_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_PRODUCT_ID=
