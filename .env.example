# Copy to .env.local for local dev, and add the same variables in
# Vercel → Project → Settings → Environment Variables. Redeploy after changing.

# --- Portfolio looks from Google Drive (optional; falls back to public/images) ---
# API key from Google Cloud Console with the Google Drive API enabled.
GOOGLE_DRIVE_API_KEY=
# The shared "Portfolio Looks" folder's id: the last part of its URL,
# drive.google.com/drive/folders/<THIS PART>. Share it as "Anyone with the link → Viewer".
GOOGLE_DRIVE_FOLDER_ID=
# Any long random string; visit /api/revalidate?secret=<it> to refresh from Drive now.
REVALIDATE_SECRET=

# --- Contact form → Google Sheet + email (optional; falls back to the visitor's email app) ---
# The Apps Script web app URL (Deploy → Manage deployments → Web app URL), ends in /exec.
CONTACT_WEBHOOK_URL=
# Any long random string; must match the script's SECRET property.
CONTACT_WEBHOOK_SECRET=

# --- Shop: set ONE of the two options ---
# Option A — a hosted checkout link (Stripe Payment Link, Square, PayPal):
NEXT_PUBLIC_CHECKOUT_URL=
# Option B — Shopify Buy Button (Shopify admin → Sales channels → Buy Button → embed code):
NEXT_PUBLIC_SHOPIFY_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_PRODUCT_ID=
